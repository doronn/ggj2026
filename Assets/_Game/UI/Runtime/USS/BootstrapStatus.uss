.bootstrap-shell {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 10, 16, 0.96);
}

.bootstrap-card {
    width: 420px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    background-color: rgba(16, 22, 28, 0.96);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 180, 220, 0.35);
    border-right-color: rgba(0, 180, 220, 0.35);
    border-top-color: rgba(0, 180, 220, 0.35);
    border-bottom-color: rgba(0, 180, 220, 0.35);
}

.bootstrap-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(248, 249, 250);
}

.bootstrap-status {
    margin-top: 8px;
    color: rgb(186, 198, 208);
}
