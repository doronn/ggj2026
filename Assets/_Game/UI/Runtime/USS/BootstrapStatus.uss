.bootstrap-shell {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(14, 18, 24, 0.96);
}

.bootstrap-card {
    width: 420px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    background-color: rgba(30, 36, 44, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.bootstrap-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(242, 245, 247);
}

.bootstrap-status {
    margin-top: 8px;
    color: rgb(194, 203, 208);
}
