%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78a51c1481be94c75a9c369ea6f45746, type: 3}
  m_Name: FoundationUiSanity
  m_EditorClassIdentifier: Ggj2026.Game.Authoring::Ggj2026.Game.Authoring.ManualTests.ManualTestScenarioDefinition
  scenarioId: foundation-ui-sanity
  milestone: ui-toolkit-foundation
  category: UI sanity
  displayName: Foundation UI Sanity
  summary: Confirms the runtime HUD, input blocking, and telemetry surfaces are active.
  steps:
  - stepId: open-bootstrap
    title: Open Bootstrap
    instruction: Enter Play Mode from Bootstrap and confirm the Persistent Main Menu
      loads.
    requiredScene: Bootstrap
    expectation:
      expectedResult: Main menu appears through a UIDocument-backed panel.
      sanityChecks: No IMGUI overlay appears and no world scene loads until you choose
        an action.
      requiresTelemetryArtifact: 1
      requiresScreenshot: 0
  - stepId: hud-click-blocking
    title: Verify HUD input capture
    instruction: Enter ClientWorld, click tool buttons, and confirm those clicks
      do not mutate the world behind the HUD.
    requiredScene: ClientWorld
    expectation:
      expectedResult: Tool selection changes, but cells are not painted until the
        pointer leaves the HUD.
      sanityChecks: No accidental selection or paint occurs while clicking or scrolling
        in the HUD.
      requiresTelemetryArtifact: 1
      requiresScreenshot: 0
